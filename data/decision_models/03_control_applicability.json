{
  "contentType": "application/vnd.gorules.decision",
  "name": "03_control_applicability",
  "description": "Maps entity protection context and operational risk cues to applicable BSI 200-2, BSI 200-4, and ISO 27002 clauses.",
  "nodes": [
    {
      "id": "dt_control_applicability",
      "type": "decisionTableNode",
      "name": "Control Applicability Filter",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          { "id": "in_etype", "name": "Entity Type", "field": "entity_type", "type": "expression" },
          { "id": "in_c", "name": "Confidentiality", "field": "confidentiality", "type": "expression" },
          { "id": "in_i", "name": "Integrity", "field": "integrity", "type": "expression" },
          { "id": "in_a", "name": "Availability", "field": "availability", "type": "expression" },
          { "id": "in_pii", "name": "Has Personal Data", "field": "has_personal_data", "type": "expression" },
          { "id": "in_email_usb", "name": "Uses Email or USB", "field": "uses_email_or_usb", "type": "expression" },
          { "id": "in_shared_acct", "name": "Uses Shared Account", "field": "uses_shared_account", "type": "expression" },
          { "id": "in_ext_vendor", "name": "Has External Vendor", "field": "has_external_vendor", "type": "expression" },
          { "id": "in_legacy", "name": "Is Legacy System", "field": "is_legacy_system", "type": "expression" },
          { "id": "in_fallback", "name": "Has Fallback Path", "field": "has_fallback_path", "type": "expression" },
          { "id": "in_rto", "name": "RTO Hours", "field": "rto_hours", "type": "expression" },
          { "id": "in_mtpd", "name": "MTPD Hours", "field": "mtpd_hours", "type": "expression" }
        ],
        "outputs": [
          { "id": "out_req", "name": "Req ID", "field": "req_id", "type": "expression" },
          { "id": "out_clause", "name": "Standard Clause", "field": "standard_clause", "type": "expression" },
          { "id": "out_title", "name": "Control Title", "field": "control_title", "type": "expression" },
          { "id": "out_cat", "name": "Gap Category", "field": "gap_category", "type": "expression" },
          { "id": "out_reason", "name": "Trigger Reason", "field": "trigger_reason", "type": "expression" }
        ],
        "rules": [
          {
            "_id": "ca_sys_inventory",
            "_description": "Every IT system requires BSI 200-2 process linkage",
            "in_etype": "\"SYSTEM\"",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R002\"",
            "out_clause": "\"BSI 200-2 Kap. 4.2\"",
            "out_title": "\"Application and IT system inventory (process linkage)\"",
            "out_cat": "\"ARCHITECTURE\"",
            "out_reason": "\"Every IT system must link to the business processes it supports for Maximumprinzip inheritance.\""
          },
          {
            "_id": "ca_owner_role",
            "_description": "Processes and systems require clear ownership",
            "in_etype": "\"PROCESS\", \"SYSTEM\"",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R003\"",
            "out_clause": "\"BSI 200-2 Kap. 4.2 / ISO 27001 Kl. 5.3\"",
            "out_title": "\"Process and asset ownership\"",
            "out_cat": "\"GOVERNANCE\"",
            "out_reason": "\"Clear organizational responsibility must be assigned for every business process and supporting system.\""
          },
          {
            "_id": "ca_email_usb_transfer",
            "_description": "Unencrypted email/USB handoffs trigger ISO 27002 A.5.14",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "true",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R054\"",
            "out_clause": "\"ISO 27002:2022 A.5.14\"",
            "out_title": "\"Information transfer security\"",
            "out_cat": "\"DATA_TRANSFER\"",
            "out_reason": "\"Operational workflow uses email attachments or USB media to transfer sensitive documents.\""
          },
          {
            "_id": "ca_shared_privileged",
            "_description": "Shared accounts or missing MFA trigger ISO 27002 A.8.2",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "true",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R101\"",
            "out_clause": "\"ISO 27002:2022 A.8.2\"",
            "out_title": "\"Privileged access rights\"",
            "out_cat": "\"ACCESS_CONTROL\"",
            "out_reason": "\"Shared or non-attributed privileged logins prevent individual accountability.\""
          },
          {
            "_id": "ca_shared_auth_mfa",
            "_description": "Shared accounts or missing MFA trigger ISO 27002 A.8.5",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "true",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R104\"",
            "out_clause": "\"ISO 27002:2022 A.8.5\"",
            "out_title": "\"Secure authentication (MFA)\"",
            "out_cat": "\"ACCESS_CONTROL\"",
            "out_reason": "\"Authentication without MFA or with shared credentials exposes administrative and citizen portals.\""
          },
          {
            "_id": "ca_external_vendor",
            "_description": "External vendor/SaaS/remote support triggers ISO 27002 A.5.19",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "true",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R059\"",
            "out_clause": "\"ISO 27002:2022 A.5.19\"",
            "out_title": "\"Information security in supplier relationships\"",
            "out_cat": "\"SUPPLIER_RISK\"",
            "out_reason": "\"External supplier/vendor access or SaaS dependency requires governed security checks and session control.\""
          },
          {
            "_id": "ca_pii_gdpr",
            "_description": "Personal citizen/employee data triggers ISO 27002 A.5.34",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "true",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R074\"",
            "out_clause": "\"ISO 27002:2022 A.5.34\"",
            "out_title": "\"Privacy and protection of PII (GDPR)\"",
            "out_cat": "\"PRIVACY_VVT\"",
            "out_reason": "\"Process or system handles personal data requiring documented legal basis, minimization, and VVT entry.\""
          },
          {
            "_id": "ca_legacy_vulns",
            "_description": "Legacy/unpatched software triggers ISO 27002 A.8.8",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "true",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R107\"",
            "out_clause": "\"ISO 27002:2022 A.8.8\"",
            "out_title": "\"Management of technical vulnerabilities\"",
            "out_cat": "\"TECHNICAL_HYGIENE\"",
            "out_reason": "\"Legacy software or SBOM exposure requires tracked patching, network isolation, or compensating controls.\""
          },
          {
            "_id": "ca_high_avail_fallback",
            "_description": "High/Very High availability without fallback triggers BSI 200-4 R021",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "\"High\", \"Very High\"",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "false",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R021\"",
            "out_clause": "\"BSI 200-4 Kap. 3.5\"",
            "out_title": "\"Emergency operation & fallback procedure\"",
            "out_cat": "\"CONTINUITY_BCM\"",
            "out_reason": "\"High-availability scope has no documented manual or technical fallback if the primary system fails.\""
          },
          {
            "_id": "ca_rto_mtpd_violation",
            "_description": "RTO >= MTPD violates BSI 200-4 continuity constraint",
            "in_etype": "",
            "in_c": "",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "!= null",
            "in_mtpd": "expr: mtpd_hours != None and rto_hours >= mtpd_hours",
            "out_req": "\"R018\"",
            "out_clause": "\"BSI 200-4 Kap. 3.2\"",
            "out_title": "\"Recovery time objective (RTO < MTPD)\"",
            "out_cat": "\"CONTINUITY_BCM\"",
            "out_reason": "\"Target recovery time (RTO) meets or exceeds maximum tolerable outage (MTPD).\""
          },
          {
            "_id": "ca_high_conf_crypto",
            "_description": "High/Very High confidentiality triggers ISO 27002 A.8.24",
            "in_etype": "",
            "in_c": "\"High\", \"Very High\"",
            "in_i": "",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R123\"",
            "out_clause": "\"ISO 27002:2022 A.8.24\"",
            "out_title": "\"Use of cryptography\"",
            "out_cat": "\"CRYPTOGRAPHY\"",
            "out_reason": "\"High confidentiality data requires verified encryption in transit and at rest.\""
          },
          {
            "_id": "ca_high_integ_logging",
            "_description": "High/Very High integrity triggers ISO 27002 A.8.15",
            "in_etype": "",
            "in_c": "",
            "in_i": "\"High\", \"Very High\"",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R114\"",
            "out_clause": "\"ISO 27002:2022 A.8.15\"",
            "out_title": "\"Logging & audit trail\"",
            "out_cat": "\"LOGGING_DETECTION\"",
            "out_reason": "\"High-integrity records require traceable audit logging for changes and access.\""
          },
          {
            "_id": "ca_high_integ_backup",
            "_description": "High/Very High integrity or availability triggers ISO 27002 A.8.13",
            "in_etype": "",
            "in_c": "",
            "in_i": "\"High\", \"Very High\"",
            "in_a": "",
            "in_pii": "",
            "in_email_usb": "",
            "in_shared_acct": "",
            "in_ext_vendor": "",
            "in_legacy": "",
            "in_fallback": "",
            "in_rto": "",
            "in_mtpd": "",
            "out_req": "\"R112\"",
            "out_clause": "\"ISO 27002:2022 A.8.13\"",
            "out_title": "\"Information backup & restore testing\"",
            "out_cat": "\"BACKUP_RECOVERY\"",
            "out_reason": "\"High-integrity processes/systems depend on verified, tested backups.\""
          }
        ]
      }
    }
  ],
  "edges": []
}

# ==============================================================================
# PMGA (Process Management and Gap Analysis) Environment Configuration
# ==============================================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://oldisserving.live

# Primary LLM Provider: 'gemini' or 'kiconnect' (OpenAI-compatible)
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini Settings (BYOK or .env fallback)
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-3.8-flash

# University KI-Connect / OpenAI-Compatible Endpoint Settings
# Note: Keep your API_KEY private. It will be loaded automatically if set.
API_BASE=
API_KEY=
API_CHAT_MODEL=kiconnect.mistralai-mistral-small-4-119b-2603

# Reliability & Rate-Limiting Protection (Pacing between requests)
LLM_MIN_INTERVAL_SEC=4.0
LLM_MAX_RETRIES=4

# Data Directories
STORAGE_DIR=storage
DATA_DIR=data

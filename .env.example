# ==============================================================================
# CivicProcess Environment Configuration
# ==============================================================================

# Application Environment: development, staging, production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-secure-random-token-in-production

# Base URL for public links and webhook payloads
APP_BASE_URL=http://localhost:8000
# For production on Coolify with Cloudflare Tunnel:
# APP_BASE_URL=https://oldisserving.live

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://oldisserving.live

# Gemini LLM Settings (BYOK: Users pass X-Gemini-API-Key header in browser)
# Optional fallback server key strictly for local testing or demo rate-limits
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Optional Webhook URL (Notifies Discord/Slack/n8n when an audit report is generated)
WEBHOOK_URL=

# Data storage directory (SQLite, uploads, exports)
STORAGE_DIR=storage
